+@pytest.mark.parametrize("enabled", [False, True])
+@pytest.mark.parametrize("phase", ["mixed", "prefill", "decode"])
+def test_exact_decode_prefix(enabled: bool, phase: str):
+    # Request-state slots deliberately differ from scheduler/batch order.
+    states = {"chunk": (4, 10), "d2": (8, 8), "tail": (6, 7), "d1": (9, 9)}
+    scheduled = {"tail": 1, "d1": 1, "chunk": 3, "d2": 1}
+    if phase != "mixed":
+        scheduled = {
+            req_id: count
+            for req_id, count in scheduled.items()
+            if req_id.startswith("d") == (phase == "decode")
+        }
+    runner = _make_runner(states, decode_query_len=1)
+    runner.phase_metadata_enabled = enabled
+    scheduler_output = SimpleNamespace(
+        num_scheduled_tokens=scheduled,
+        total_num_scheduled_tokens=sum(scheduled.values()),
+        scheduled_spec_decode_tokens={},
+    )
+    state, uniform_count = runner.gather_batch_req_state(scheduler_output, False)
+    assert state is not None
+    # A synthetic intent argument must never override real request state.
+    state_with_intent, _ = runner.gather_batch_req_state(
+        scheduler_output, False, dummy_num_decode_tokens=0
+    )
+    assert state_with_intent is not None
+    assert state_with_intent.num_decode_tokens == state.num_decode_tokens
+    assert state_with_intent.req_ids == state.req_ids
+    expected = {
+        "mixed": ["d1", "d2", "tail", "chunk"]
+        if enabled
+        else ["tail", "d1", "d2", "chunk"],
+        "prefill": ["tail", "chunk"],
+        "decode": ["d1", "d2"],
+    }[phase]
+    assert state.req_ids == expected
+    assert state.num_decode_tokens == (
+        (0 if phase == "prefill" else 2) if enabled else None
+    )
+    assert state.num_tokens == sum(scheduled.values())
+    assert state.has_prefill == (phase != "decode")
+    assert uniform_count == (1 if phase == "decode" else None)
+    np.testing.assert_array_equal(
+        state.num_scheduled_tokens, [scheduled[r] for r in expected]
+    )
+    np.testing.assert_array_equal(
+        state.idx_mapping_np, [list(states).index(r) for r in expected]
+    )
+    np.testing.assert_array_equal(
+        state.prefill_len_np, [states[r][1] for r in expected]
+    )
+    np.testing.assert_array_equal(
+        state.num_computed_prefill_tokens_np, [states[r][0] for r in expected]
+    )
+    np.testing.assert_array_equal(
+        state.is_prefilling_np, [states[r][0] < states[r][1] for r in expected]
+    )
+
+
